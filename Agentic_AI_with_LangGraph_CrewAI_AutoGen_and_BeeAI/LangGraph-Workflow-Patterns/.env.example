# Copy this file to .env in the project root and replace the placeholders
# with your OWN IBM watsonx.ai credentials and project configuration.
# Never commit .env or real credentials to version control.

# Required: IBM watsonx.ai configuration (validated by llm.py on first use).
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://your-region.ml.cloud.ibm.com
WATSONX_MODEL_ID=your-model-id-for-example-ibm-granite-3-8b-instruct
