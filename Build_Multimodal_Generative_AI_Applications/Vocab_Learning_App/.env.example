# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# Your API key for the LLM provider. Required.
LLM_API_KEY=your_api_key_here

# Any OpenRouter-compatible chat completions endpoint.
LLM_BASE_URL=https://openrouter.ai/api/v1

# The model used for generating the lesson.
LLM_MODEL=your_model_here

# Optional tuning (defaults shown).
# MAX_VOCABULARY_ITEMS=15
# LLM_REQUEST_TIMEOUT=120
# Set to 1 to also expose a temporary public Gradio link.
# GRADIO_SHARE=0
