# Copy this file to .env and replace the placeholders.
# Never commit .env or real credentials.

# Required: IBM watsonx.ai credentials and endpoint.
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://your-region.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/your-model-id

# Optional: currently declared but not used by the application.
WATSONX_PROJECT_NAME=your-project-name

# Optional application settings. These values match the code defaults.
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=documents
VECTOR_SEARCH_K=10
HYBRID_RETRIEVER_WEIGHTS=[0.4, 0.6]
LOG_LEVEL=INFO
CACHE_DIR=document_cache
CACHE_EXPIRE_DAYS=7

# Docling PDF conversion. Enable OCR for scanned PDFs and table structure
# when structured table content is required.
DOCLING_DO_OCR=false
DOCLING_DO_TABLE_STRUCTURE=false
DOCLING_DOCUMENT_TIMEOUT=300.0
