# IBM watsonx.ai credentials
#
# For a personal IBM Cloud project, set all three values.
# Leave WATSONX_API_KEY empty to use the IBM Skills Network lab defaults
# (no explicit API key, project_id="skills-network").
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=skills-network
