# Copy to .env and fill in your own values. Never commit .env.
WATSONX_API_KEY=ADD_API_KEY_HERE
WATSONX_PROJECT_ID=ADD_PROJECT_ID_HERE
WATSONX_PROJECT_NAME=ADD_PROJECT_NAME_HERE
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small
TAVILY_API_KEY=ADD_TAVILY_API_KEY_HERE

# How to get your tavily API key:
    # Just sign up for a free account at https://tavily.com/signup and get your API key from the dashboard.

# How to get your watsonx.ai API key and project ID:
    # 1. Sign up for a free IBM Cloud account at https://cloud.ibm.com/registration
    # 2. Create a watsonx.ai instance at https://cloud.ibm.com/catalog/services/watsonx-ai
    # 3. Create a project in the watsonx.ai console and get your project ID and API key from the project settings.
