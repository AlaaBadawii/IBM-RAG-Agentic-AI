OPENROUTER_API_KEY=<YOUR_OPENROUTER_KEY>
# The project sends this key to OPENROUTER_BASE_URL
# (https://openrouter.ai/api/v1), so its value must be an OpenRouter key
# (the sk-or-v1-… family), not an OpenAI platform key (sk-proj-…). Takes
# precedence when both are set.
# Legacy alias for the same value; OPENROUTER_API_KEY above is preferred.
OPENAI_API_KEY=<YOUR_OPENROUTER_KEY>
LINKEDIN_CLIENT_ID=<YOUR_LINKEDIN_CLIENT_ID>
LINKEDIN_CLIENT_SECRET=<YOUR_LINKEDIN_CLIENT_SECRET>

# Operational failure notification (PLAN.md Step 7). All required values must
# be set for a notification to be attempted; while any is empty the
# application still runs and still records failures, it just cannot alert.
# For Gmail: an app password, not the account password, and the sender address
# must be the account that owns it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=<YOUR_GMAIL_ADDRESS>
SMTP_RECIPIENT=<WHERE_ALERTS_SHOULD_GO>
SMTP_USERNAME=<YOUR_GMAIL_ADDRESS>
SMTP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
# starttls | ssl | none
SMTP_TLS=starttls
